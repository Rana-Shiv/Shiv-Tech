---
/**
 * Página individual de cada case, gerada a partir dos arquivos em
 * src/content/cases/. Mesma lógica dos produtos: um .md novo vira uma página.
 */
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { url } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const cases = await getCollection('cases');
  return cases.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;

const blocos = [
  { rotulo: 'Problema', texto: d.problema },
  { rotulo: 'Contexto', texto: d.contexto },
  { rotulo: 'Solução', texto: d.solucao },
];
---

<Base titulo={d.titulo} descricao={d.descricaoSeo}>
  <section class="topo-case">
    <div class="container">
      <nav class="breadcrumb" aria-label="Trilha de navegação">
        <a href={url('/')}>Início</a>
        <span aria-hidden="true">/</span>
        <a href={url('/cases')}>Projetos e cases</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{d.titulo}</span>
      </nav>

      <div class="meta">
        <span class="meta-cliente">{d.cliente}</span>
        {d.setor && <span class="meta-setor">{d.setor}</span>}
        {d.emAndamento && <span class="badge badge-soon">Em andamento</span>}
      </div>

      <h1>{d.titulo}</h1>
      <p class="lead">{d.chamada}</p>
    </div>
  </section>

  <section class="resumo">
    <div class="container">
      <dl class="blocos">
        {
          blocos.map((bloco) => (
            <div class="bloco">
              <dt>{bloco.rotulo}</dt>
              <dd>{bloco.texto}</dd>
            </div>
          ))
        }
      </dl>

      {
        d.tecnologias.length > 0 && (
          <div class="tecnologias">
            <h2>Tecnologia</h2>
            <ul class="pill-list">
              {d.tecnologias.map((tecnologia) => (
                <li class="pill">{tecnologia}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        d.resultado ? (
          <div class="resultado">
            <h2>Resultado</h2>
            <p>{d.resultado}</p>
          </div>
        ) : (
          <p class="sem-resultado">
            Projeto em andamento. Publicaremos resultados quando houver dado
            medido — não estimativa.
          </p>
        )
      }
    </div>
  </section>

  <section class="conteudo">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  <CTA
    titulo="Tem um problema parecido?"
    texto="Cada empresa é diferente, mas os padrões se repetem. Conte a sua situação e a gente diz se dá para resolver de forma parecida."
  />
</Base>

<style>
  .topo-case {
    padding-block: 56px 26px;
  }

  .topo-case h1 {
    font-size: clamp(2.1rem, 5vw, 3.5rem);
    margin: 14px 0;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .meta-cliente {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cyan-soft);
    font-weight: 700;
  }

  .meta-setor {
    font-size: 0.85rem;
    color: var(--muted-soft);
  }

  .blocos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .bloco {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.03);
  }

  .bloco dt {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cyan);
    font-weight: 700;
    margin-bottom: 9px;
  }

  .bloco dd {
    color: var(--muted);
    font-size: 0.96rem;
  }

  .tecnologias,
  .resultado {
    margin-top: 34px;
  }

  .tecnologias h2,
  .resultado h2 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cyan-soft);
    margin-bottom: 13px;
  }

  .resultado p {
    color: var(--text);
    font-size: 1.06rem;
    max-width: 760px;
  }

  .sem-resultado {
    margin-top: 34px;
    color: var(--muted-soft);
    font-size: 0.93rem;
    font-style: italic;
    max-width: 700px;
  }

  .conteudo {
    padding-block: 30px 60px;
  }

  @media (max-width: 860px) {
    .blocos {
      grid-template-columns: 1fr;
    }
  }
</style>
